{
  "display_information": {
    "name": "OpenCode bridge",
    "description": "Thread-bound coding requests on your own OpenCode server"
  },
  "features": {
    "bot_user": { "display_name": "OpenCode", "always_online": false }
  },
  "oauth_config": {
    "scopes": {
      "bot": ["app_mentions:read", "chat:write", "users:read", "channels:history", "groups:history"]
    }
  },
  "settings": {
    "socket_mode_enabled": true,
    "interactivity": { "is_enabled": true },
    "event_subscriptions": { "bot_events": ["app_mention", "message.channels", "message.groups"] }
  }
}
